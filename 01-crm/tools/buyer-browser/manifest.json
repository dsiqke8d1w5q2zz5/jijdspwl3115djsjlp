{
  "manifest_version": 3,
  "name": "房仲管家・物件搜尋助手",
  "version": "1.2.15",
  "description": "從正常開啟的房產搜尋頁讀取公開物件，供房仲管家手動搜尋與本機每日配對。",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://dsiqke8d1w5q2zz5.github.io/jijdspwl3115djsjlp/01-crm/*",
    "https://buy.yungching.com.tw/*",
    "https://www.sinyi.com.tw/*",
    "https://sale.591.com.tw/*",
    "https://business.591.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dsiqke8d1w5q2zz5.github.io/jijdspwl3115djsjlp/01-crm/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ],
  "action": {
    "default_title": "房仲管家物件搜尋助手",
    "default_popup": "popup.html"
  }
}
